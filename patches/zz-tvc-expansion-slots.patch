-  void TVC64VM::setMultiSoundEnabled(bool enabled)
+  uint8_t TVC64VM::cardIDByte() const
   {
-    if (soundCards)
-      soundCards->setMultiSoundEnabled(enabled);
+    uint8_t retval = 0x00;
+    for (int i = 3; i >= 0; i--) {
+      // the IOS gives the name "DISK" to a card with ID 2, and initializes
+      // cards with ID 3 from the "MOPS" header of their ROM
+      retval = uint8_t(retval << 2)
+               | uint8_t(effectiveSlotCard(i) == SLOT_VTDOS ? 2 : 3);
+    }
+    return retval;
+  }
