+  int TVC64VM::mapSlotPort(uint16_t addr) const
+  {
+    int     slot = int((addr >> 4) & 7) - 1;
+    if (slot < 0 || slot > 3 || effectiveSlotCard(slot) != SLOT_VTDOS)
+      return -1;
+    return 0x10 | int(addr & 0x0F);
   }
 
