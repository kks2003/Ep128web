-  void TVC64VM::setCard256Enabled(bool enabled)
+  void TVC64VM::setSlotCard(int slot, int card)
   {
-    if (card256)
-      card256->setEnabled(enabled);
+    if (slot < 0 || slot > 3)
+      return;
+    if (card < SLOT_EMPTY || card > SLOT_CARD256)
+      card = SLOT_EMPTY;
+    if (card != SLOT_EMPTY) {
+      for (int i = 0; i < 4; i++) {     // a card can only be in one slot
+        if (slotCards[i] == card)
+          slotCards[i] = SLOT_EMPTY;
+      }
+    }
+    slotCards[slot] = uint8_t(card);
+    int     gameCardSlot = -1;
+    int     multiSoundSlot = -1;
+    int     card256Slot = -1;
+    for (int i = 0; i < 4; i++) {
+      if (slotCards[i] == SLOT_GAMECARD)
+        gameCardSlot = i;
+      else if (slotCards[i] == SLOT_MULTISOUND)
+        multiSoundSlot = i;
+      else if (slotCards[i] == SLOT_CARD256)
+        card256Slot = i;
+    }
+    if (soundCards) {
+      soundCards->setGameCardSlot(gameCardSlot);
+      soundCards->setMultiSoundSlot(multiSoundSlot);
+    }
+    if (card256) {
+      if (card256Slot >= 0)
+        card256->setSlot(card256Slot);
+      card256->setEnabled(card256Slot >= 0);
+    }
   }
 
