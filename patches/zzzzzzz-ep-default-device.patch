diff --git a/src/ep128vm.cpp b/src/ep128vm.cpp
index acbfa40..9644a10 100644
--- a/src/ep128vm.cpp
+++ b/src/ep128vm.cpp
@@ -541,7 +541,12 @@ namespace Ep128 {
       R.AF.B.h = 0x00;
       break;
     case 0x0E:                          // get if default device is 'FILE:'
