{
  "name": "Enterprise 128 · TVC emulátor",
  "short_name": "EP128 · TVC",
  "description": "Enterprise 128 és Videoton TVC emulátor a böngészőben (ep128emu WebAssembly port)",
  "lang": "hu",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0c0e22",
  "theme_color": "#1b1f45",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/octet-stream": [
          ".cas",
          ".dsk",
          ".img",
          ".tap",
          ".ep128s",
          ".com",
          ".bas"
        ],
        "application/zip": [
          ".zip"
        ]
      }
    }
  ]
}
